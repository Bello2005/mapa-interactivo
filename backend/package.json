{
  "name": "choco-biogeografico-backend",
  "version": "1.0.0",
  "description": "Backend minimalista de solo lectura para el proyecto Chocó Biogeográfico",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed-layers.ts",
    "seed:force": "tsx scripts/seed-layers.ts --force",
    "import-geojson": "tsx scripts/import-geojson.ts"
  },
  "keywords": [
    "choco",
    "biodiversidad",
    "api",
    "mongodb"
  ],
  "author": "IIAP - Instituto de Investigaciones Ambientales del Pacífico",
  "license": "MIT",
  "dependencies": {
    "@turf/bbox-clip": "^7.3.1",
    "@turf/simplify": "^7.3.1",
    "@turf/turf": "^7.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
